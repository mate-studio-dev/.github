{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Default preset for use with Mate Studio's repos",
  "extends": [
    "config:best-practices",
    "group:linters",
    ":semanticCommits",
    ":semanticCommitScope(deps)",
    "docker:enableMajor"
  ],
  "labels": ["dependencies"],
  "timezone": "Europe/Berlin",
  "schedule": ["after 10pm on monday", "before 5am on tuesday"],
  "rangeStrategy": "bump",
  "platformCommit": "enabled",
  "minimumReleaseAge": "7 days",
  "automergeType": "pr",
  "platformAutomerge": true,
  "lockFileMaintenance": {
    "automerge": true,
    "schedule": ["after 10pm on monday", "before 5am on tuesday"]
  },
  "vulnerabilityAlerts": {
    "labels": ["security"]
  },
  "packageRules": [
    {
      "description": "Automerge non-major updates of stable packages. 0.x minors can break",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "matchCurrentVersion": "!/^v?0\\./",
      "automerge": true
    },
    {
      "matchPackageNames": ["@antfu/eslint-config"],
      "groupName": "linters"
    },
    {
      "matchPackageNames": ["prettier", "@prettier/**", "prettier-plugin-**"],
      "groupName": "prettier packages"
    },
    {
      "matchPackageNames": ["vite", "@vitejs/**", "vite-**", "@storybook/builder-vite"],
      "groupName": "vite"
    },
    {
      "matchPackageNames": ["urql", "@urql/**", "urql-**"],
      "groupName": "urql"
    },
    {
      "matchPackageNames": ["@pqina/**"],
      "groupName": "pintura"
    }
  ]
}
